{
  "authentication": {
    "enabled": false,
    "jwt": {
      "algorithm": "HS256",
      "expiration_hours": 24,
      "refresh_enabled": true
    },
    "mfa": {
      "enabled": false,
      "methods": [
        "totp",
        "sms"
      ],
      "backup_codes": true
    },
    "rbac": {
      "enabled": false,
      "default_role": "admin",
      "roles": {
        "admin": [
          "*"
        ],
        "user": [
          "read",
          "experiment:create"
        ],
        "viewer": [
          "read"
        ]
      }
    }
  },
  "security": {
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 100,
      "burst_limit": 200
    },
    "cors": {
      "enabled": true,
      "origins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "headers": [
        "Content-Type",
        "Authorization"
      ]
    },
    "headers": {
      "x_frame_options": "DENY",
      "x_content_type_options": "nosniff",
      "x_xss_protection": "1; mode=block"
    }
  }
}